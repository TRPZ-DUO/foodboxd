// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Visibilidade {
  PUBLICO
  PRIVADO
}

enum TipoAtividade {
  AVALIACAO_CRIADA
  COMENTARIO_CRIADO
  FAVORITO_ADICIONADO
  LISTA_CRIADA
  SEGUIDOR_ADICIONADO
}

model Usuario {
  id          String   @id @default(uuid()) @db.Uuid
  nomeUsuario String   @unique
  email       String   @unique
  senhaHash   String
  biografia   String?
  avatar      String?
  dataCriacao DateTime @default(now())
  
  curtidasAvaliacao CurtidaAvaliacao[]
  avaliacoes Avaliacao[]
  favoritos Favorito[]
  listas Lista[]
  comentarios Comentario[]
  curtidasComentarios CurtidaComentario[]
  atividades Atividade[]

  seguindo Seguidor[] @relation("Seguidores")
  seguidores Seguidor[] @relation("Seguindo")

  @@map("usuarios")
  
}

model Categoria {
  id String @id @default(uuid()) @db.Uuid
  nome String @unique

  restaurantes Restaurante[]
}

model Restaurante {
  id String @id @default(uuid()) @db.Uuid
  nome String 
  descricao String?
  endereco String
  cidade String
  estado String
  latitude Float?
  longitude Float?

  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  categoriaId String @db.Uuid
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@index([categoriaId])
  @@index([nome])

  pratos Prato[]
}



model Prato {
  id String @id @default(uuid()) @db.Uuid
  nome String
  descricao String? 
  imagemUrl String?
  mediaAvaliacoes Decimal @default(0) //posteriormente calcular a partir da tabela avaliacao

  restauranteId String @db.Uuid
  restaurante Restaurante @relation(fields: [restauranteId], references: [id])

  @@index([restauranteId, nome])
  @@index([nome])

  tags PratoTag[]
  avaliacoes Avaliacao[]
  favoritos Favorito[]
  itens ItemLista[]
}

model Tag {
  id String @id @default(uuid()) @db.Uuid
  nome String @unique

  pratos PratoTag[]
}

model PratoTag {
  pratoId String @db.Uuid
  tagId String @db.Uuid

  prato Prato @relation(fields: [pratoId], references: [id])
  tag Tag @relation(fields: [tagId], references: [id])

  @@index([tagId])

  @@id([pratoId, tagId])
}

model Avaliacao {
  id String @id @default(uuid()) @db.Uuid
  nota Decimal @db.Decimal(2,1)
  descricao String?

  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pratoId String @db.Uuid
  prato Prato @relation(fields: [pratoId], references: [id])

  usuarioId String @db.Uuid
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, pratoId])

  @@index([pratoId])

  fotos FotoAvaliacao[]
  curtidas CurtidaAvaliacao[]
  comentarios Comentario[]

}

model FotoAvaliacao {
  id String @id @default(uuid()) @db.Uuid
  urlImagem String?

  avaliacaoId String @db.Uuid

  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id])

  @@index([avaliacaoId])
}

model CurtidaAvaliacao {
  id String @id @default(uuid()) @db.Uuid

  criadoEm DateTime @default(now())

  avaliacaoId String @db.Uuid
  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id])

  usuarioId String @db.Uuid
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([avaliacaoId, usuarioId])

  @@index([avaliacaoId])
}

model Favorito {
  id String @id @default(uuid()) @db.Uuid
  
  criadoEm DateTime @default(now())
  
  usuarioId String @db.Uuid
  pratoId String @db.Uuid

  prato Prato @relation(fields: [pratoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, pratoId])
  
  @@index([usuarioId])
  @@index([pratoId])
}

model Lista {
  id String @id @default(uuid()) @db.Uuid
  titulo String
  descricao String?
  visibilidade Visibilidade
  criadoEm DateTime @default(now())

  usuarioId String @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  itens ItemLista[]
}

model ItemLista {
  id String @id @default(uuid()) @db.Uuid
  posicao Int

  pratoId String @db.Uuid
  listaId String @db.Uuid

  prato Prato @relation(fields: [pratoId], references: [id])
  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)



  @@unique([listaId, pratoId])
  @@unique([listaId, posicao])
  
  @@index([listaId])
  @@index([pratoId])
}

model Seguidor {
  id String @id @default(uuid()) @db.Uuid

  criadoEm DateTime @default(now())

  seguidorId String @db.Uuid
  seguidoId String @db.Uuid

  seguidor Usuario @relation("Seguidores", fields: [seguidorId], references: [id])
  seguido Usuario @relation("Seguindo", fields: [seguidoId], references: [id])

  @@unique([seguidorId, seguidoId])
  @@index([seguidorId])
  @@index([seguidoId])

}

model Comentario {
  id String @id @default(uuid()) @db.Uuid
  conteudo String
  
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  avaliacaoId String @db.Uuid
  usuarioId String @db.Uuid

  curtidas CurtidaComentario[]

  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model CurtidaComentario {
  id String @id @default(uuid()) @db.Uuid

  criadoEm DateTime @default(now())

  comentarioId String @db.Uuid
  usuarioId String @db.Uuid

  comentario Comentario @relation(fields: [comentarioId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])


  @@unique([comentarioId, usuarioId])
  @@index([comentarioId])
  @@index([usuarioId])
}

model Atividade {
  id String @id @default(uuid()) @db.Uuid
  tipo TipoAtividade
  usuarioId String @db.Uuid
  referenciaId String @db.Uuid
  criadoEm DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, criadoEm, id])
  @@index ([criadoEm])
}